# Copy this file to ".env" and change the values (local use). On Vercel, set these in Settings > Environment Variables.
PORT=3000
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database file lives
DB_PATH=./data/bank.db
# Set to "true" to load demo users when the database is empty
SEED_DEMO=true
